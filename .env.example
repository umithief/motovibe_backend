NODE_ENV=development
PORT=5001
BASE_URL=http://localhost:5001
MONGO_URI=mongodb://localhost:27017/motovibe
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
# Opaque refresh-session lifetime in milliseconds (default: 30 days)
JWT_REFRESH_TTL_MS=2592000000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local deployment tools only. Prefer a restricted deployment user and SSH key.
DEPLOY_HOST=your-server.example.com
DEPLOY_PORT=22
DEPLOY_USERNAME=deploy
DEPLOY_PRIVATE_KEY_PATH=C:/path/to/deploy-key
# DEPLOY_PASSWORD=use_only_when_key_auth_is_unavailable
BODY_LIMIT=1mb
UPLOAD_MAX_BYTES=10485760

# Optional integrations
FIREBASE_STORAGE_BUCKET=replace_with_your_bucket
REDIS_URI=redis://localhost:6379
GEMINI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
LASTFM_API_KEY=
# Apex road-network previews use the Mapbox Optimization API. Keep this
# restricted token only on the backend; do not copy a production token here.
MAPBOX_DIRECTIONS_ACCESS_TOKEN=replace_with_mapbox_directions_token

# Motorcycle intelligence and map data platform. All third-party calls remain
# backend-only. Optional enrichments degrade gracefully when disabled.
ROUTING_PROVIDER=mapbox
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
VALHALLA_BASE_URL=
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_ELEVATION_BASE_URL=https://api.open-meteo.com/v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GEO_WEATHER_ENABLED=true
GEO_POI_ENABLED=true
GEO_ELEVATION_ENABLED=true
GEO_WILDFIRE_ENABLED=false
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
GEO_WILDFIRE_DAYS=1
GEO_WILDFIRE_ROUTE_CORRIDOR_KM=20
GEO_TRAFFIC_ENABLED=false
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_BASE_URL=https://api.tomtom.com
GEO_TRAFFIC_SAMPLE_COUNT=5
GEO_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
GEO_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
GEO_RIDE_SCORE_WEIGHTS={"weather":0.20,"traffic":0.15,"curves":0.15,"scenery":0.20,"poi":0.10,"elevation":0.05,"safety":0.15}
OVERTURE_API_URL=
GEO_OVERTURE_ENABLED=false
GEO_OFFICIAL_DATA_ENABLED=false
GEO_DISCOVERY_ENABLED=false
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
GEO_DISCOVERY_SAMPLE_COUNT=3
GEO_DISCOVERY_RADIUS_METERS=10000
GEO_DISCOVERY_LIMIT=18
GEO_MAX_NEARBY_RADIUS_METERS=50000
GEO_MAX_POI_RESULTS=100
GEO_MAX_ROUTE_DISTANCE_KM=750
GEO_SAMPLE_SPACING_KM=20
GEO_ROAD_REPORT_MAX_TTL_HOURS=168

# MotoVibe BİZ commerce. Both this flag and iyzico credentials are required.
# Callback base must be a public HTTPS URL in production (or a sandbox tunnel).
BIZ_COMMERCE_ENABLED=false
BIZ_COMMISSION_RATE=8
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_URI=https://sandbox-api.iyzipay.com
IYZIPAY_CALLBACK_BASE_URL=
SHOP_CARD_PAYMENTS_ENABLED=false
# Configure at least one verification mechanism in production. The signing
# secret validates RevenueCat's timestamped HMAC-SHA256 signature. The auth
# value must include the full configured header, for example: Bearer <secret>.
# Email & SMTP Settings (Password Reset & System Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="MotoVibe Destek" <noreply@motovibe.app>

# SMS & Emergency SOS Provider (Twilio or Netgsm)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=MOTOVIBE

# Explicit, one-time admin bootstrap. Keep false in normal operation.
SEED_ADMIN=false
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional deployment helpers
DEPLOY_HOST=server.example.com
DEPLOY_PORT=22
DEPLOY_USERNAME=deploy
DEPLOY_PASSWORD=replace_with_deployment_password

# External secret mount only; never keep credentials in this source directory.
GOOGLE_APPLICATION_CREDENTIALS=
SEED_DEMO_DATA=false
HTTP_REQUEST_LOGGING=false
# Production shared caches are disabled while Redis is unavailable.
